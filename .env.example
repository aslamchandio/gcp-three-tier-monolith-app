# Copy to .env for LOCAL development only. In production these are set by the
# VM startup script, and DB_PASSWORD is injected from Google Secret Manager.
# .env is never required in production and must not be committed with real values.

# --- Server ---
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (Cloud SQL PostgreSQL over PRIVATE IP) ---
# In production DB_HOST is the Cloud SQL private IP (e.g. 10.77.0.2).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=changeme-local-only
DB_MAX_CONNECTIONS=10
# 'require' = TLS in transit (matches Cloud SQL ENCRYPTED_ONLY). Use 'disable' for a local plaintext dev DB.
DB_SSL_MODE=require

# --- Timeouts ---
REQUEST_TIMEOUT_SECONDS=15
DB_COMMAND_TIMEOUT_SECONDS=10

# --- Catalog sync (replaces the standalone catalog-service sync loop) ---
# Upstream product feed synced into the products table (reached via Cloud NAT in prod).
FAKESTORE_URL=https://fakestoreapi.com/products
SYNC_INTERVAL_HOURS=6
SYNC_ON_STARTUP=true
